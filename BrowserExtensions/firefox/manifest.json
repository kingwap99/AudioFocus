{
  "manifest_version": 2,
  "name": "AudioFocus Tab Controller",
  "version": "1.0.0",
  "description": "Keeps the last focused audible tab playing and fades other tabs out.",
  "permissions": ["tabs", "<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "audiofocus-tab-controller@local"
    }
  }
}
